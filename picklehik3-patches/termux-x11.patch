+package com.termux.x11;
+
+import android.util.Log;
+
+public class XServer {
+    private static final String TAG = "XServer";
+    private boolean running = false;
+    private Thread serverThread;
+
+    public void start(final int display) {
+        if (running) {
+            Log.w(TAG, "X server already running");
+            return;
+        }
+        Log.i(TAG, "Starting X server on display :" + display);
+        running = true;
+        serverThread = new Thread(() -> {
+            try {
+                runServer(display);
+            } catch (Exception e) {
+                Log.e(TAG, "X server error", e);
+            }
+        }, "xserver-thread");
+        serverThread.start();
+    }
+
+    public void stop() {
+        if (!running) {
+            return;
+        }
+        Log.i(TAG, "Stopping X server");
+        running = false;
+        if (serverThread != null) {
+            serverThread.interrupt();
+            try {
+                serverThread.join(2000);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+            serverThread = null;
+        }
+    }
+
+    public boolean isRunning() {
+        return running;
+    }
+
+    private void runServer(int display) {
+        android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_URGENT_DISPLAY);
+        while (running) {
+            try {
+                Thread.sleep(100);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                break;
+            }
+        }
+    }
+}
